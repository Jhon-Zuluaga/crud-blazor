@page "/categories/editar/{Id:int}"
@rendermode InteractiveServer
@inject CategoryService Servicio
@inject NavigationManager Nav

<PageTitle>Editar categoria</PageTitle>
<h1>Editar categoria</h1>

@if (!loaded)
{
    <p><em>Cargando...</em></p>
}
else if (category is null)
{
    <div class="alert alert-warning">Categoria no encontrado.</div>
    <a href="categories">Volver al listado</a>
}
else
{
    <CategoryForm Modelo="category" OnSave="SaveAsync" OnCancel="Back" />
}

@code {
    [Parameter] public int Id { get; set; }

    private Category? category;
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        category = await Servicio.GetAsync(Id);
        loaded = true;
    }

    private async Task SaveAsync()
    {
        await Servicio.updateAsync(category!);
        Back();
    }

    private void Back() => Nav.NavigateTo("/categories");
}