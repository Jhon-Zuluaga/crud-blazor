@page "/categories/crear"
@rendermode InteractiveServer
@inject CategoryService Servicio
@inject NavigationManager Nav

<PageTitle>Nueva categoria</PageTitle>
<h1>Nueva categoria</h1>

<CategoryForm Modelo="category" OnSave="SaveAsync" OnCancel="Back" />

@code {
    private readonly Category category = new();

    private async Task SaveAsync()
    {
        await Servicio.CreateAsync(category);
        Back();
    }

    private void Back() => Nav.NavigateTo("/categories");
}