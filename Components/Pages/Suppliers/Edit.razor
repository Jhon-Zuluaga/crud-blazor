@page "/suppliers/editar/{Id:int}"
@rendermode InteractiveServer
@inject SupplierService Servicio
@inject NavigationManager Nav

<PageTitle>Editar proveedor</PageTitle>
<h1>Editar proveedor</h1>

@if (!loaded)
{
    <p><em>Cargando...</em></p>
}
else if (supplier is null)
{
    <div class="alert alert-warning">Proveedor no encontrado.</div>
    <a href="suppliers">Volver al listado</a>
}
else
{
    <SupplierForm Modelo="supplier" OnSave="SaveAsync" OnCancel="Back" />
}

@code {
    [Parameter] public int Id { get; set; }

    private Supplier? supplier;
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        supplier = await Servicio.GetAsync(Id);
        loaded = true;
    }

    private async Task SaveAsync()
    {
        await Servicio.UpdateAsync(supplier!);
        Back();
    }

    private void Back() => Nav.NavigateTo("/suppliers");
}