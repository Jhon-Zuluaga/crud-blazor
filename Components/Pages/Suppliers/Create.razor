@page "/suppliers/crear"
@rendermode InteractiveServer
@inject SupplierService Servicio
@inject NavigationManager Nav

<PageTitle>Nuevo proveedor</PageTitle>
<h1>Nuevo proveedor</h1>

<SupplierForm Modelo="supplier" OnSave="SaveAsync" OnCancel="Back" />

@code {
    private readonly Supplier supplier = new();

    private async Task SaveAsync()
    {
        await Servicio.CreateAsync(supplier);
        Back();
    }

    private void Back() => Nav.NavigateTo("/suppliers");
}