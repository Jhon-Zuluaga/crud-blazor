@page "/products/editar/{Id:int}"
@rendermode InteractiveServer
@inject ProductService Servicio
@inject NavigationManager Nav

<PageTitle>Editar producto</PageTitle>
<h1>Editar producto</h1>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (!loaded)
{
    <p><em>Cargando...</em></p>
}
else if (product is null)
{
    <div class="alert alert-warning">Producto no encontrado.</div>
    <a href="suppliers">Volver al listado</a>
}
else
{
    <ProductForm Modelo="product" OnSave="SaveAsync" OnCancel="Back" />
}

@code {
    [Parameter] public int Id { get; set; }

    private Product? product;
    public string? error;
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        product = await Servicio.GetAsync(Id);
        loaded = true;
    }

    private async Task SaveAsync()
    {
        error = await Servicio.UpdateAsync(product!);
        if (error is null) Back();
    }

    private void Back() => Nav.NavigateTo("/products");
}