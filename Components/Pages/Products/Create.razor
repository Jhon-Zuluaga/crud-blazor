@page "/products/crear"
@rendermode InteractiveServer
@inject ProductService Servicio
@inject NavigationManager Nav

<PageTitle>Nuevo producto</PageTitle>
<h1>Nuevo producto</h1>
@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<ProductForm Modelo="product" OnSave="SaveAsync" OnCancel="Back" />

@code {
    private readonly Product product = new();
    private string? error;

    private async Task SaveAsync()
    {
        error = await Servicio.CreateAsync(product);
        if (error is null) Back();
    }

    private void Back() => Nav.NavigateTo("/products");
}